# ============================================
# VARIABLES DE ENTORNO - FRONTEND
# ============================================
# 
# Este archivo de ejemplo muestra todas las variables
# que necesita la aplicación para funcionar.
# 
# INSTRUCCIONES:
# 1. Copia este archivo y guárdalo como .env
# 2. Reemplaza los valores según tu entorno
# 3. NUNCA hagas commit del archivo .env (está en .gitignore)
# 
# VARIABLES DISPONIBLES:
# - REACT_APP_API_URL: URL base del servidor backend
#   Se usa en services/api.js para todas las peticiones HTTP
# 

# URL del API backend - Cambia según tu entorno
REACT_APP_API_URL=http://localhost:8000/api
