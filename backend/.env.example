# ============================================
# VARIABLES DE ENTORNO - BACKEND
# ============================================
# 
# Este archivo de ejemplo muestra todas las variables
# que necesita la aplicación para funcionar.
# 
# INSTRUCCIONES:
# 1. Copia este archivo y guárdalo como .env
# 2. Reemplaza los valores según tu entorno
# 3. NUNCA hagas commit del archivo .env (está en .gitignore)
# 

# ============================================
# BASE DE DATOS
# ============================================
# Conexión a PostgreSQL (reemplaza user, password, localhost, db_name)
DATABASE_URL=postgresql://user:password@localhost:5432/mi_proyecto

# ============================================
# SEGURIDAD
# ============================================
# Clave secreta para firmar tokens JWT
# Genera una aleatoria: openssl rand -hex 32
SECRET_KEY=tu_clave_secreta_muy_larga_y_aleatoria_aqui

# ============================================
# APLICACIÓN
# ============================================
# true para desarrollo, false para producción
DEBUG=True
